<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MechScope" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <style name="Theme.MechScope.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#58C4DE</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#101820</item>
    </style>
    <style name="Theme.MechScope.Launch" parent="Theme.MechScope">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
